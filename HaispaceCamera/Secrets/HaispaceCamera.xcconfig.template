// HaispaceCamera.xcconfig
// HaispaceCamera — Build Configuration
//
// ⚠️  FILE INI HARUS ADA DI .gitignore
// Berisi credentials yang tidak boleh masuk ke repository.
//
// CARA SETUP (untuk developer baru):
// 1. Copy file ini dari template: Secrets/HaispaceCamera.xcconfig.template
// 2. Isi nilai yang kosong dengan credentials dari password manager tim
// 3. Pastikan file ini TIDAK pernah di-commit ke git

// ── Cloudflare R2 Credentials ───────────────────────────────────────────────
// Sama dengan HaispaceBooths — log dari iPhone juga diupload ke R2.

R2_ACCOUNT_ID = GANTI_DENGAN_ACCOUNT_ID
R2_ACCESS_KEY_ID = GANTI_DENGAN_ACCESS_KEY_ID
R2_SECRET_KEY = GANTI_DENGAN_SECRET_KEY
R2_BUCKET = haispaceproject
R2_PUBLIC_BASE_URL = https://api.haispaceproject.my.id/r2-media
R2_ENDPOINT = https://GANTI_DENGAN_ACCOUNT_ID.r2.cloudflarestorage.com
