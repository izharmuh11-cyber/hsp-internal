<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundle Identity -->
	<key>CFBundleIdentifier</key>
	<string>id.haispaceproject.booth</string>
	<key>CFBundleName</key>
	<string>HaiBooth</string>
	<key>CFBundleDisplayName</key>
	<string>HaiBooth</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>id</string>

	<!-- Platform -->
	<key>MinimumOSVersion</key>
	<string>17.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer><!-- iPad only -->
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Kiosk Mode: Selalu fullscreen -->
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Privacy Descriptions (wajib Apple) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>HaiBooth membutuhkan akses jaringan lokal untuk berbagi foto dengan iPhone kamera dan untuk pengiriman foto ke tamu via WiFi lokal.</string>
	<key>NSCameraUsageDescription</key>
	<string>HaiBooth membutuhkan kamera untuk scan QR Code pairing dengan HaiCamera.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>HaiBooth akan menyimpan foto hasil sesi ke galeri Anda.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>HaiBooth menggunakan Bluetooth untuk menghubungkan iPhone kamera tanpa WiFi tambahan.</string>
	<key>NFCReaderUsageDescription</key>
	<string>HaiBooth tidak menggunakan NFC.</string>

	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>background-processing</string><!-- BGProcessingTask untuk license heartbeat -->
		<string>remote-notification</string><!-- Push notification untuk license update -->
		<string>fetch</string><!-- BGAppRefreshTask backup -->
	</array>

	<!-- Background Task Identifiers -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>id.haispaceproject.booth.license-check</string>
		<string>id.haispaceproject.booth.photo-upload</string>
	</array>

	<!-- URL Session Background Identifier -->
	<key>NSURLSessionIdentifier</key>
	<string>id.haispaceproject.booth.photo-upload</string>

	<!-- Bonjour Services (untuk local network photo sharing) -->
	<key>NSBonjourServices</key>
	<array>
		<string>_haibooth._tcp</string>
	</array>

	<!-- ATS: Allow local network communication -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<!-- Hanya untuk development — hapus di production -->
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- Kiosk: Nonaktifkan auto-lock via entitlement (jika diperlukan) -->
	<!-- UIApplicationExitsOnSuspend tidak digunakan di iOS 13+ -->

	<!-- App Icon -->
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon</string>
			</array>
		</dict>
	</dict>

	<!-- File Sharing for Logs -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Secrets Injection from xcconfig -->
	<key>R2_ACCOUNT_ID</key>
	<string>$(R2_ACCOUNT_ID)</string>
	<key>R2_ACCESS_KEY_ID</key>
	<string>$(R2_ACCESS_KEY_ID)</string>
	<key>R2_SECRET_KEY</key>
	<string>$(R2_SECRET_KEY)</string>
	<key>R2_BUCKET</key>
	<string>$(R2_BUCKET)</string>
	<key>R2_PUBLIC_BASE_URL</key>
	<string>$(R2_PUBLIC_BASE_URL)</string>
	<key>R2_ENDPOINT</key>
	<string>$(R2_ENDPOINT)</string>
	<key>QR_PAYLOAD_SHARED_SECRET</key>
	<string>$(QR_PAYLOAD_SHARED_SECRET)</string>
	<key>LICENSE_API_BASE_URL</key>
	<string>$(LICENSE_API_BASE_URL)</string>
</dict>
</plist>
