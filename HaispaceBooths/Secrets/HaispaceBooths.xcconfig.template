// HaispaceBooths.xcconfig
// HaispaceBooths — Build Configuration
//
// ⚠️  FILE INI HARUS ADA DI .gitignore
// Berisi credentials yang tidak boleh masuk ke repository.
//
// CARA SETUP (untuk developer baru):
// 1. Copy file ini dari template: Secrets/HaispaceBooths.xcconfig.template
// 2. Isi nilai yang kosong dengan credentials dari password manager tim
// 3. Pastikan file ini TIDAK pernah di-commit ke git
//
// Ref: docs/design/ADR-001_workflow_ownership.md (Security section)

// ── Cloudflare R2 Credentials ───────────────────────────────────────────────
// Akses ke bucket R2 untuk log upload.
// Dapatkan dari: Cloudflare Dashboard → R2 → API Tokens
// Scope minimal: Object Read & Write untuk bucket "haispaceproject" saja.

R2_ACCOUNT_ID = 66c40e0caaaa333ca0f4977bf32be2a7
R2_ACCESS_KEY_ID = ccf641ce7fee6d2f1ec4c07a927f0b9c
R2_SECRET_KEY = abd1bc78a2c92791610e68cf4c0d253a56090740a67eec5462f667c91858eb34
R2_BUCKET = haispaceproject
R2_PUBLIC_BASE_URL = https:/$()/api.haispaceproject.my.id/r2-media
R2_ENDPOINT = https:/$()/66c40e0caaaa333ca0f4977bf32be2a7.r2.cloudflarestorage.com

// ── QR Payload HMAC Secret ───────────────────────────────────────────────────
// Digunakan untuk sign QR payload pembayaran.
// Harus sama antara iPad dan server payment gateway.

QR_PAYLOAD_SHARED_SECRET = GANTI_DENGAN_QR_SECRET

// ── License API ──────────────────────────────────────────────────────────────
// Base URL untuk license heartbeat dan activation.

LICENSE_API_BASE_URL = https:/$()/api.haispace.id
